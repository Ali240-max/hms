{
  "name": "hms",
  "version": "0.1.0",
  "private": true,
  "description": "Hospital management: OPD, prescriptions and pharmacy on one server",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "verify:pharmacy": "node verify-pharmacy.mjs",
    "verify:chits": "node verify-chits.mjs",
    "verify:screens": "node verify-screens.mjs",
    "verify:i18n": "node verify-i18n.mjs",
    "reset-password": "tsx scripts/reset-password.ts",
    "verify:billing": "node verify-billing.mjs",
    "verify:render": "node .rendercheck/build.mjs && node .rendercheck/run.mjs",
    "verify:emergency": "node verify-emergency.mjs",
    "verify:roles": "node verify-roles.mjs",
    "verify:lan": "node verify-lan.mjs",
    "setup": "tsx scripts/setup.ts",
    "build:server": "node scripts/build-server.mjs",
    "verify:supplies": "node verify-supplies.mjs",
    "verify:lab": "node verify-lab.mjs",
    "seed:pharmacy": "tsx scripts/seed-pharmacy.ts",
    "verify:returns": "node verify-returns.mjs",
    "verify:modules": "node verify-modules.mjs",
    "verify:reports": "node verify-reports.mjs",
    "verify:numbering": "node verify-numbering.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@hono/node-server": "^1.13.7",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.47.0",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
