{
  "include": ["src/server/**/*", "scripts/**/*", "verify-*.ts"],
  "compilerOptions": {
    "module": "ESNext", "moduleResolution": "bundler", "target": "ES2022",
    "lib": ["ES2022"], "types": ["node"], "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "noEmit": true, "resolveJsonModule": true
  }
}
